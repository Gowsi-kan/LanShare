<Window
    x:Class="LanShare.Views.PromptWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="460"
    Background="#0E1014"
    CanResize="False"
    SizeToContent="Height"
    SystemDecorations="None"
    Topmost="True"
    WindowStartupLocation="CenterScreen">

    <Border BorderBrush="#2A3A66" BorderThickness="1">
        <StackPanel>
            <Border
                Height="38"
                Background="#12151C"
                BorderBrush="#232834"
                BorderThickness="0,0,0,1"
                PointerPressed="OnTitlePointerPressed">
                <TextBlock
                    x:Name="TitleText"
                    Margin="14,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold" />
            </Border>

            <StackPanel Margin="18" Spacing="12">
                <TextBlock
                    x:Name="HeadingText"
                    FontSize="16"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap" />

                <Border
                    x:Name="CodeBox"
                    Padding="12"
                    Classes="card"
                    IsVisible="False">
                    <TextBlock
                        x:Name="CodeText"
                        HorizontalAlignment="Center"
                        FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace"
                        FontSize="34"
                        FontWeight="Bold"
                        Foreground="#4C8DFF" />
                </Border>

                <ScrollViewer
                    x:Name="LineScroll"
                    MaxHeight="130"
                    IsVisible="False">
                    <ItemsControl x:Name="Lines" />
                </ScrollViewer>

                <TextBlock
                    x:Name="BodyText"
                    Classes="muted"
                    TextWrapping="Wrap" />

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="CancelBtn"
                        Classes="ghost"
                        Click="OnCancel" />
                    <Button
                        x:Name="ConfirmBtn"
                        Classes="primary"
                        Click="OnConfirm" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>