<Window
    x:Class="LanShare.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:LanShare.Core"
    xmlns:views="using:LanShare.Views"
    xmlns:vm="using:LanShare.ViewModels"
    Title="LanShare"
    Width="1240"
    Height="760"
    MinWidth="920"
    MinHeight="600"
    x:DataType="vm:MainViewModel"
    Background="#0A0F18"
    CanResize="True"
    DragDrop.AllowDrop="True"
    Icon="/Assets/app.ico"
    SystemDecorations="None"
    WindowStartupLocation="CenterScreen">
    <Panel>
        <Border
            x:Name="ContentRoot"
            BorderBrush="#253248"
            BorderThickness="1">
            <Grid RowDefinitions="44,*">
                <!--  ===== Custom title bar =====  -->
                <Border
                    Background="#0F1724"
                    BorderBrush="#253248"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <Border Background="Transparent" PointerPressed="OnTitlePointerPressed">
                            <StackPanel
                                Margin="18,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="10">
                                <Border
                                    Width="22"
                                    Height="22"
                                    Background="#3978F6"
                                    CornerRadius="7">
                                    <Path
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M0,3 L10,3 M7,0 L10,3 L7,6 M10,9 L0,9 M3,6 L0,9 L3,12"
                                        Stroke="White"
                                        StrokeJoin="Round"
                                        StrokeLineCap="Round"
                                        StrokeThickness="1.4" />
                                </Border>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="LanShare" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="muted"
                                    Text="PRIVATE • DIRECT • LOCAL" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="muted"
                                    Text=" · " />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="muted"
                                    Text="{Binding BuildStamp}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button
                                Classes="winbtn"
                                Click="OnSettings"
                                ToolTip.Tip="Settings">
                                <Path
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M0,0 L11,0 M0,4.5 L11,4.5 M0,9 L11,9"
                                    Stroke="#C9D1E3"
                                    StrokeThickness="1.2" />
                            </Button>
                            <Button
                                Classes="winbtn"
                                Click="OnMinimize"
                                ToolTip.Tip="Minimize">
                                <Path
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M0,0 L10,0"
                                    Stroke="#C9D1E3"
                                    StrokeThickness="1.2" />
                            </Button>
                            <Button
                                Classes="winbtn close"
                                Click="OnClose"
                                ToolTip.Tip="Close">
                                <Path
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M0,0 L10,10 M10,0 L0,10"
                                    Stroke="#C9D1E3"
                                    StrokeThickness="1.2" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  ===== Body =====  -->
                <Grid
                    Grid.Row="1"
                    Margin="18"
                    ColumnDefinitions="300,*"
                    ColumnSpacing="16">
                    <!--  Left rail: fixed cards + elastic device list (scrolls inside itself)  -->
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                        <Border Padding="14,12" Classes="card">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="lbl" Text="YOUR DEVICE" />
                                <TextBlock
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Text="{Binding DeviceName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="muted" Text="{Binding ListenText}" />
                                <Border
                                    Height="1"
                                    Margin="0,6"
                                    Background="#253248" />
                                <TextBlock Classes="lbl" Text="NETWORK ACCESS" />
                                <TextBlock
                                    MaxHeight="48"
                                    Classes="muted"
                                    Text="{Binding FirewallText}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    ToolTip.Tip="{Binding FirewallText}" />
                                <Button
                                    Margin="0,4,0,0"
                                    Classes="primary small"
                                    Command="{Binding OpenFirewallCommand}"
                                    Content="Allow through firewall"
                                    IsEnabled="{Binding !FirewallBusy}"
                                    IsVisible="{Binding FirewallNeedsAction}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Padding="14"
                            Classes="card">
                            <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
                                <TextBlock Classes="lbl" Text="DEVICES ON YOUR NETWORK" />
                                <ListBox
                                    Grid.Row="1"
                                    MinHeight="60"
                                    Background="Transparent"
                                    ItemsSource="{Binding Peers}"
                                    SelectedItem="{Binding SelectedPeer}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="core:Peer">
                                            <Grid
                                                Margin="2,3"
                                                ColumnDefinitions="*,Auto"
                                                ColumnSpacing="8">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Classes="muted"
                                                    Text="{Binding Address}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock
                                    Grid.Row="2"
                                    Classes="muted"
                                    IsVisible="{Binding PeersHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Text="{Binding PeersHint}" />
                                <Grid
                                    Grid.Row="3"
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="8">
                                    <TextBox Text="{Binding ManualHost}" Watermark="Connect by IPv4 address" />
                                    <Button
                                        Grid.Column="1"
                                        Classes="ghost"
                                        Command="{Binding AddPeerCommand}"
                                        Content="Add" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Row="2"
                            Padding="14"
                            Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="lbl" Text="RECEIVING" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{Binding DownloadDir}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip.Tip="{Binding DownloadDir}" />
                                    <Button
                                        Grid.Column="1"
                                        Classes="ghost small"
                                        Click="OnPickDownloadDir"
                                        Content="Change…" />
                                </Grid>
                                <StackPanel Spacing="3">
                                    <ProgressBar
                                        Height="6"
                                        Foreground="#E8B75A"
                                        Maximum="100"
                                        Minimum="0"
                                        Value="{Binding DiskUsedPercent}" />
                                    <TextBlock Classes="muted" Text="{Binding DiskText}" />
                                </StackPanel>
                                <CheckBox Content="Auto-accept incoming transfers" IsChecked="{Binding AutoAccept}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  Right: drop zone, send options, transfers  -->
                    <Grid
                        Grid.Column="1"
                        RowDefinitions="Auto,Auto,Auto,*"
                        RowSpacing="12">
                        <Border
                            Padding="22,18"
                            Background="#111D31"
                            BorderBrush="#2A4164"
                            Classes="card">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center" Spacing="5">
                                    <TextBlock
                                        Classes="pageTitle"
                                        Text="Send files privately" />
                                    <TextBlock
                                        Classes="muted"
                                        FontSize="13"
                                        Text="{Binding TargetText}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        MinHeight="16"
                                        FontSize="12"
                                        Foreground="#FF9AA8"
                                        Text="{Binding StatusMessage}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip.Tip="{Binding StatusMessage}" />
                                    <Border
                                        Margin="0,4,0,0"
                                        Padding="10,6"
                                        Background="#1B2D49"
                                        CornerRadius="8"
                                        IsVisible="{Binding HasPending}">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{Binding PendingText}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Button
                                                Grid.Column="1"
                                                Classes="primary small"
                                                Command="{Binding SendPendingCommand}"
                                                Content="Send" />
                                            <Button
                                                Grid.Column="2"
                                                Classes="ghost small"
                                                Command="{Binding CancelPendingCommand}"
                                                Content="Clear" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        Classes="primary"
                                        Click="OnAddFiles"
                                        Content="Add files…" />
                                    <Button
                                        Classes="ghost"
                                        Click="OnAddFolder"
                                        Content="Add folder…" />
                                    <Button
                                        Classes="ghost"
                                        Click="OnPhoneAccess"
                                        Content="Phone access" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Padding="16,12"
                            Classes="card"
                            ToolTip.Tip="Send options apply to new transfers">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="20">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Classes="muted"
                                            Text="Parallel streams"
                                            ToolTip.Tip="Auto adapts to the connection; manual mode supports up to 16 streams." />
                                        <TextBlock
                                            Grid.Column="1"
                                            MinWidth="36"
                                            Classes="val"
                                            FontSize="12"
                                            Text="{Binding StreamsText}"
                                            TextAlignment="Right" />
                                    </Grid>
                                    <Slider
                                        IsSnapToTickEnabled="True"
                                        Maximum="16"
                                        Minimum="0"
                                        TickFrequency="1"
                                        Value="{Binding StreamsSetting}" />
                                </StackPanel>
                                <CheckBox
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="Adaptive compression"
                                    IsChecked="{Binding CompressionEnabled}" />
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Classes="muted"
                                        Text="Speed limit" />
                                    <ComboBox
                                        Width="130"
                                        ItemsSource="{Binding BandwidthOptions}"
                                        SelectedIndex="{Binding BandwidthIndex}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Row="2"
                            Grid.RowSpan="2"
                            Padding="14,14,10,10"
                            Classes="card">
                            <TabControl Classes="activityTabs" SelectedIndex="{Binding ActivityTabIndex}">
                            <TabItem Classes="activityTab" Header="Transfers">
                                <Grid>
                                    <ScrollViewer Padding="0,0,12,0" IsVisible="{Binding HasTransfers}">
                                        <ItemsControl ItemsSource="{Binding Transfers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:TransferViewModel">
                                                    <views:TransferCardView />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding !HasTransfers}"
                                        Spacing="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Text="No transfers yet" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Classes="muted"
                                            Text="Started and incoming transfers will appear here." />
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem Classes="activityTab" Header="{Binding QueueCountText}">
                                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                    <Border Padding="16" Background="#111E31" BorderBrush="#29466D" Classes="card">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                            <Border
                                                Width="42"
                                                Height="42"
                                                VerticalAlignment="Center"
                                                Background="#1B3152"
                                                CornerRadius="12">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="#78A8FF"
                                                    Text="↗" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Text="Ready to send" />
                                                <TextBlock
                                                    Classes="muted"
                                                    Text="Review each batch before it leaves this device. Sequential sending preserves existing stream tuning." />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="10">
                                                <Border
                                                    Padding="10,6"
                                                    VerticalAlignment="Center"
                                                    Background="#15263E"
                                                    CornerRadius="8">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Foreground="#8DB4FF"
                                                        Text="SEQUENTIAL" />
                                                </Border>
                                                <Button
                                                    Classes="primary"
                                                    Command="{Binding StartQueuedSendCommand}"
                                                    Content="Start queue"
                                                    IsEnabled="{Binding HasQueuedSends}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="1">
                                        <ScrollViewer Padding="0,0,12,0" IsVisible="{Binding HasQueuedSends}">
                                            <ItemsControl ItemsSource="{Binding SendQueue}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:QueuedSendViewModel">
                                                        <Border
                                                            Margin="0,0,0,10"
                                                            Padding="16"
                                                            BorderBrush="#2A3A51"
                                                            Classes="card">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                                                <StackPanel Spacing="6">
                                                                    <TextBlock Classes="lbl" Text="DESTINATION DEVICE" />
                                                                    <TextBlock
                                                                        FontWeight="SemiBold"
                                                                        Text="{Binding PeerText}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Classes="muted">
                                                                        <Run Text="{Binding FileCount}" />
                                                                        <Run Text=" files · " />
                                                                        <Run Text="{Binding SizeText}" />
                                                                    </TextBlock>
                                                                    <TextBlock
                                                                        Classes="muted"
                                                                        Text="{Binding FilePreview}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        ToolTip.Tip="{Binding FilePreview}" />
                                                                    <TextBlock
                                                                        Foreground="#FF9AA8"
                                                                        IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                        Text="{Binding ErrorText}"
                                                                        TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Orientation="Horizontal"
                                                                    Spacing="5">
                                                                    <Button
                                                                        Classes="ghost small"
                                                                        Command="{Binding MoveUpCommand}"
                                                                        Content="↑"
                                                                        ToolTip.Tip="Move batch up" />
                                                                    <Button
                                                                        Classes="ghost small"
                                                                        Command="{Binding MoveDownCommand}"
                                                                        Content="↓"
                                                                        ToolTip.Tip="Move batch down" />
                                                                    <Button
                                                                        Classes="danger small"
                                                                        Command="{Binding RemoveCommand}"
                                                                        Content="Remove" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding !HasQueuedSends}"
                                            Spacing="8">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Text="Your send queue is clear" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Classes="muted"
                                                Text="Select a device and add files to review a batch." />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </TabItem>
                            <TabItem Classes="activityTab" Header="{Binding HistoryCountText}">
                                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                                    <Grid
                                        Margin="14,0"
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="8">
                                        <TextBox
                                            Watermark="Search history…"
                                            Text="{Binding HistoryQuery, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            Classes="ghost small"
                                            Click="OnExportHistory"
                                            Content="Export CSV"
                                            ToolTip.Tip="Export the complete local transfer history, including peer names, errors, and locations." />
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <ScrollViewer IsVisible="{Binding HasFilteredHistory}">
                                            <ItemsControl ItemsSource="{Binding FilteredHistory}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TransferHistoryItem">
                                                        <Border
                                                            Margin="14,0,14,10"
                                                            Padding="0"
                                                            Classes="card">
                                                            <Grid ColumnDefinitions="3,*">
                                                                <Border
                                                                    Background="{Binding OutcomeBrush}"
                                                                    CornerRadius="12,0,0,12" />
                                                                <Grid
                                                                    Grid.Column="1"
                                                                    Margin="16,14"
                                                                    ColumnDefinitions="Auto,*,Auto"
                                                                    RowDefinitions="Auto,Auto,Auto"
                                                                    ColumnSpacing="12"
                                                                    RowSpacing="12">
                                                                    <Border
                                                                        Width="36"
                                                                        Height="36"
                                                                        VerticalAlignment="Center"
                                                                        Background="#1B2D49"
                                                                        CornerRadius="10">
                                                                        <TextBlock
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="17"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="#76A6FF"
                                                                            Text="{Binding DirectionGlyph}" />
                                                                    </Border>
                                                                    <StackPanel
                                                                        Grid.Column="1"
                                                                        VerticalAlignment="Center"
                                                                        Spacing="3">
                                                                        <TextBlock
                                                                            FontSize="14"
                                                                            FontWeight="SemiBold"
                                                                            Text="{Binding Title}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock
                                                                            Classes="muted"
                                                                            Text="{Binding Timestamp}" />
                                                                    </StackPanel>
                                                                    <Border
                                                                        Grid.Column="2"
                                                                        Padding="10,5"
                                                                        VerticalAlignment="Center"
                                                                        Background="{Binding OutcomeSurface}"
                                                                        CornerRadius="7">
                                                                        <TextBlock
                                                                            FontSize="10"
                                                                            FontWeight="Bold"
                                                                            Foreground="{Binding OutcomeBrush}"
                                                                            Text="{Binding Outcome}" />
                                                                    </Border>
                                                                    <Grid
                                                                        Grid.Row="1"
                                                                        Grid.ColumnSpan="3"
                                                                        ColumnDefinitions="*,*"
                                                                        ColumnSpacing="10">
                                                                        <Border
                                                                            Padding="10,8"
                                                                            Background="#101827"
                                                                            CornerRadius="8">
                                                                            <StackPanel Spacing="2">
                                                                                <TextBlock Classes="lbl" Text="FILES" />
                                                                                <TextBlock
                                                                                    Classes="val"
                                                                                    FontSize="13"
                                                                                    Text="{Binding Summary}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <Border
                                                                            Grid.Column="1"
                                                                            Padding="10,8"
                                                                            Background="#101827"
                                                                            CornerRadius="8">
                                                                            <StackPanel Spacing="2">
                                                                                <TextBlock Classes="lbl" Text="TOTAL SIZE" />
                                                                                <TextBlock
                                                                                    Classes="val"
                                                                                    FontSize="13"
                                                                                    Text="{Binding SizeText}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Grid>
                                                                    <TextBlock
                                                                        Grid.Row="2"
                                                                        Grid.ColumnSpan="2"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="#FF9AA8"
                                                                        IsVisible="{Binding HasError}"
                                                                        Text="{Binding Error}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        ToolTip.Tip="{Binding Error}" />
                                                                    <StackPanel
                                                                        Grid.Row="2"
                                                                        Grid.Column="2"
                                                                        Orientation="Horizontal"
                                                                        Spacing="8">
                                                                        <Button
                                                                            Classes="primary small"
                                                                            Command="{Binding RetryCommand}"
                                                                            Content="Queue retry"
                                                                            IsVisible="{Binding CanRetry}" />
                                                                        <Button
                                                                            Classes="ghost small"
                                                                            Command="{Binding OpenLocationCommand}"
                                                                            Content="Open location"
                                                                            IsVisible="{Binding CanOpenLocation}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Classes="muted"
                                            IsVisible="{Binding !HasFilteredHistory}"
                                            Text="No matching history. Try a different search or complete a transfer first." />
                                    </Grid>
                                </Grid>
                            </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!--  dims (and blurs, see code-behind) the whole main window while Phone / Settings are open  -->
        <Border
            x:Name="DimOverlay"
            Background="#99000000"
            IsHitTestVisible="False"
            Opacity="0">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Border.Transitions>
        </Border>
    </Panel>
</Window>
