<Window
    x:Class="LanShare.Views.SettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LanShare.ViewModels"
    Title="Settings"
    Width="460"
    Height="540"
    x:DataType="vm:MainViewModel"
    Background="#0E1014"
    CanResize="False"
    SystemDecorations="None"
    WindowStartupLocation="CenterOwner">

    <Border BorderBrush="#232834" BorderThickness="1">
        <Grid RowDefinitions="38,*">

            <Border
                Background="#12151C"
                BorderBrush="#232834"
                BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <Border Background="Transparent" PointerPressed="OnTitlePointerPressed">
                        <TextBlock
                            Margin="14,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Settings" />
                    </Border>
                    <Button
                        Grid.Column="1"
                        Classes="winbtn close"
                        Click="OnClose"
                        ToolTip.Tip="Close">
                        <Path
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M0,0 L10,10 M10,0 L0,10"
                            Stroke="#C9D1E3"
                            StrokeThickness="1.2" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel
                Grid.Row="1"
                Margin="16"
                Spacing="12">

                <Border Padding="14,12" Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="lbl" Text="BACKGROUND" />
                        <CheckBox Content="Run in background (system tray)" IsChecked="{Binding RunInBackground}" />
                        <TextBlock
                            Classes="muted"
                            Text="Minimize and Close hide the window and LanShare keeps receiving. Use the tray icon to open or quit."
                            TextWrapping="Wrap" />
                        <CheckBox Content="Desktop notifications" IsChecked="{Binding NotificationsEnabled}" />
                        <TextBlock
                            Classes="muted"
                            Text="Pop-up when a file arrives, a transfer finishes or fails, while the window is hidden or unfocused."
                            TextWrapping="Wrap" />
                        <CheckBox Content="Start with Windows / Linux login" IsChecked="{Binding StartWithSystem}" />
                        <TextBlock
                            Classes="muted"
                            Text="Starts hidden in the tray. Works for the published app, not for 'dotnet run'."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Padding="14,12" Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="lbl" Text="FILE MANAGER" />
                        <CheckBox Content="Right-click menu: Send with LanShare" IsChecked="{Binding ContextMenuEnabled}" />
                        <TextBlock
                            Classes="muted"
                            Text="Windows: right-click files or folders (Windows 11: Show more options). Linux: Files, Nemo and Dolphin, plus Open With. Select a device in LanShare afterwards and click Send."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Classes="muted"
                    Text="No tray icon on your Linux desktop (for example GNOME without the AppIndicator extension)? Start LanShare again from the app menu and it brings the window back, or turn off Run in background."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</Window>