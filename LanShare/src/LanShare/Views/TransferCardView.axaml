<UserControl
    x:Class="LanShare.Views.TransferCardView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LanShare.ViewModels"
    x:DataType="vm:TransferViewModel">

    <Border
        Margin="0,0,0,10"
        Padding="18"
        Classes="card">
        <StackPanel Spacing="10">

            <!--  Header: glyph | file name (takes the leftover width and trims) | state badge  -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border
                    Width="34"
                    Height="34"
                    VerticalAlignment="Center"
                    Background="#1B2D49"
                    CornerRadius="10">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#76A6FF"
                        Text="{Binding DirectionGlyph}" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding Title}" />
                <Border
                    Grid.Column="2"
                    MaxWidth="240"
                    Padding="10,3"
                    VerticalAlignment="Center"
                    Background="#182437"
                    BorderBrush="#2B3A51"
                    BorderThickness="1"
                    CornerRadius="999">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{Binding PhaseBrush}"
                        Text="{Binding PhaseText}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip.Tip="{Binding PhaseText}" />
                </Border>
            </Grid>

            <TextBlock
                Classes="muted"
                Text="{Binding Subtitle}"
                TextTrimming="CharacterEllipsis"
                ToolTip.Tip="{Binding Subtitle}" />

            <Border
                Padding="14"
                Background="#101B2B"
                BorderBrush="#2A3A51"
                BorderThickness="1"
                CornerRadius="10"
                IsVisible="{Binding IsAwaiting}">
                <StackPanel Spacing="6">
                    <TextBlock Classes="lbl" Text="INCOMING TRANSFER REVIEW" />
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding IncomingReviewText}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Classes="muted"
                        Text="{Binding IncomingFilesPreview}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Classes="muted"
                        Text="{Binding ConflictPreview}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        HorizontalAlignment="Left"
                        MinWidth="250"
                        ItemsSource="{Binding ConflictHandlingOptions}"
                        SelectedIndex="{Binding ConflictHandlingIndex}" />
                </StackPanel>
            </Border>

            <Border
                Padding="12,10"
                Background="#2A2022"
                BorderBrush="#62453A"
                BorderThickness="1"
                CornerRadius="9"
                IsVisible="{Binding RecoveryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="#F5B942"
                        Text="RECOVERY GUIDANCE" />
                    <TextBlock
                        FontSize="12"
                        Foreground="#FFD2A0"
                        Text="{Binding RecoveryText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ProgressBar
                Height="6"
                Margin="0,2"
                Foreground="{Binding PhaseBrush}"
                Maximum="100"
                Minimum="0"
                Value="{Binding Percent}" />

            <!--  Stats: proportional columns, every value trims instead of overflowing  -->
            <Grid ColumnDefinitions="1.6*,1.1*,1*,1.3*" ColumnSpacing="10">
                <Border Padding="10,8" Background="#101827" CornerRadius="8">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="lbl" Text="TRANSFERRED" />
                        <TextBlock
                            Classes="val"
                            FontSize="13"
                            Text="{Binding Transferred}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{Binding Transferred}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="10,8" Background="#101827" CornerRadius="8">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="lbl" Text="SPEED" />
                        <TextBlock
                            Classes="val"
                            FontSize="13"
                            Text="{Binding SpeedText}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{Binding SpeedText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="10,8" Background="#101827" CornerRadius="8">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="lbl" Text="ETA" />
                        <TextBlock
                            Classes="val"
                            FontSize="13"
                            Text="{Binding EtaText}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{Binding EtaText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="10,8" Background="#101827" CornerRadius="8">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="lbl" Text="LINK" />
                        <TextBlock
                            Classes="val"
                            FontSize="13"
                            Text="{Binding LinkText}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{Binding LinkText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Spacing="2">
                <TextBlock
                    Classes="muted"
                    Text="{Binding FilesText}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding FilesText}" />
                <TextBlock
                    Classes="muted"
                    Text="{Binding CurrentFile}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding CurrentFile}" />
                <TextBlock
                    Classes="muted"
                    IsVisible="{Binding DiagText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Text="{Binding DiagText}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding DiagText}" />
            </StackPanel>

            <!--  Actions on their own row, so they can never collide with the text above  -->
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">

                <Button
                    Classes="ghost small"
                    Click="OnCopyDetails"
                    Content="Copy details" />
                <Button
                    Classes="primary small"
                    Command="{Binding AcceptCommand}"
                    Content="Accept"
                    IsVisible="{Binding IsAwaiting}" />
                <Button
                    Classes="ghost small"
                    Command="{Binding DeclineCommand}"
                    Content="Decline"
                    IsVisible="{Binding IsAwaiting}" />
                <Button
                    Classes="ghost small"
                    Command="{Binding PauseCommand}"
                    Content="Pause"
                    IsVisible="{Binding CanPause}" />
                <Button
                    Classes="primary small"
                    Command="{Binding ResumeCommand}"
                    Content="Resume"
                    IsVisible="{Binding CanResume}" />
                <Button
                    Classes="danger small"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    IsVisible="{Binding IsActive}" />
                <Button
                    Classes="primary small"
                    Command="{Binding RetryCommand}"
                    Content="Retry / Resume"
                    IsVisible="{Binding CanRetry}" />
                <Button
                    Classes="ghost small"
                    Command="{Binding OpenFolderCommand}"
                    Content="Open folder"
                    IsVisible="{Binding CanOpenFolder}" />
                <Button
                    Classes="ghost small"
                    Command="{Binding DismissCommand}"
                    Content="Dismiss"
                    IsVisible="{Binding IsFinished}" />
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>