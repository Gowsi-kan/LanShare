<Window
    x:Class="LanShare.Views.PhoneAccessWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:LanShare.Views"
    xmlns:vm="using:LanShare.ViewModels"
    Title="Phone / browser access"
    Width="920"
    Height="640"
    x:DataType="vm:PhoneAccessViewModel"
    Background="#0A0F18"
    CanResize="False"
    SystemDecorations="None"
    WindowStartupLocation="CenterOwner">

    <Border BorderBrush="#253248" BorderThickness="1">
        <Grid RowDefinitions="38,*">

            <Border
                Background="#0F1724"
                BorderBrush="#253248"
                BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <Border Background="Transparent" PointerPressed="OnTitlePointerPressed">
                        <TextBlock
                            Margin="14,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Phone / browser access" />
                    </Border>
                    <Button
                        Grid.Column="1"
                        Classes="winbtn close"
                        Click="OnClose"
                        ToolTip.Tip="Close">
                        <Path
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M0,0 L10,10 M10,0 L0,10"
                            Stroke="#C9D1E3"
                            StrokeThickness="1.2" />
                    </Button>
                </Grid>
            </Border>

            <Grid
                Grid.Row="1"
                Margin="12"
                ColumnDefinitions="340,*"
                ColumnSpacing="12">

                <!--  Left: start/stop, QR  -->
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">
                    <TextBlock
                        Classes="muted"
                        Text="Open the address on a phone browser on the same Wi-Fi. Nothing to install on the phone."
                        TextWrapping="Wrap" />

                    <StackPanel Grid.Row="1" Spacing="6">
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Classes="primary"
                            Command="{Binding ToggleCommand}"
                            Content="{Binding ToggleText}"
                            IsEnabled="{Binding !Busy}" />
                        <TextBlock
                            Classes="muted"
                            Text="{Binding Status}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        Grid.Row="2"
                        Padding="12"
                        Classes="card"
                        IsVisible="{Binding IsRunning}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border
                                    Padding="6"
                                    Background="White"
                                    CornerRadius="8">
                                    <Image
                                        Width="140"
                                        Height="140"
                                        Source="{Binding Qr}" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                                    <TextBlock Classes="lbl" Text="PIN FOR THE PHONE" />
                                    <TextBlock
                                        FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace"
                                        FontSize="30"
                                        FontWeight="Bold"
                                        Foreground="#76A6FF"
                                        Text="{Binding Pin}" />
                                    <Button
                                        HorizontalAlignment="Left"
                                        Classes="ghost small"
                                        Command="{Binding NewPinCommand}"
                                        Content="New PIN" />
                                </StackPanel>
                            </Grid>
                            <TextBox
                                FontSize="12"
                                IsReadOnly="True"
                                Text="{Binding Url}"
                                TextWrapping="Wrap" />
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                IsVisible="{Binding HasMultipleAddresses}"
                                ItemsSource="{Binding Addresses}"
                                SelectedItem="{Binding SelectedAddress}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    Classes="ghost small"
                                    Click="OnCopy"
                                    Content="Copy link" />
                                <Button
                                    Classes="ghost small"
                                    Command="{Binding OpenFirewallCommand}"
                                    Content="Allow through firewall" />
                            </StackPanel>
                            <TextBlock
                                MaxHeight="32"
                                Classes="muted"
                                Text="{Binding FirewallText}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                ToolTip.Tip="{Binding FirewallText}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Spacing="2">
                        <CheckBox Content="Ask me before accepting phone uploads" IsChecked="{Binding AskApproval}" />
                        <CheckBox
                            Content="Use HTTPS (phone shows a certificate warning once)"
                            IsChecked="{Binding UseHttps}"
                            IsEnabled="{Binding !IsRunning}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="5"
                        Classes="muted"
                        Text="The QR code alone is not enough: the phone also needs the PIN. Without HTTPS the traffic on your Wi-Fi is readable by others on it, so use HTTPS on shared networks."
                        TextWrapping="Wrap" />
                </Grid>

                <!--  Right: shared files + live transfers  -->
                <Grid
                    Grid.Column="1"
                    RowDefinitions="2*,3*"
                    RowSpacing="10">

                    <Border Padding="12" Classes="card">
                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="lbl"
                                    Text="SHARED WITH PHONES" />
                                <Button
                                    Grid.Column="1"
                                    Classes="ghost small"
                                    Click="OnAddFiles"
                                    Content="Add files…" />
                            </Grid>
                            <ListBox
                                Grid.Row="1"
                                MinHeight="60"
                                Background="Transparent"
                                ItemsSource="{Binding Shared}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SharedFileItem">
                                        <Grid
                                            Margin="2,3"
                                            ColumnDefinitions="*,Auto,Auto"
                                            ColumnSpacing="8">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Classes="muted"
                                                Text="{Binding SizeText}" />
                                            <Button
                                                Grid.Column="2"
                                                Classes="danger small"
                                                Command="{Binding RemoveCommand}"
                                                Content="Remove" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Padding="12"
                        Classes="card">
                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <TextBlock Classes="lbl" Text="TRANSFERS WITH PHONES" />
                            <ScrollViewer Grid.Row="1" Padding="0,0,12,0">
                                <ItemsControl ItemsSource="{Binding Transfers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TransferViewModel">
                                            <views:TransferCardView />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>